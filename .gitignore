# Visual Studio y configuracion personal del IDE.
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.pubxml.user

# Salidas de compilacion, restauracion y publicacion de .NET.
[Bb][Ii][Nn]/
[Oo][Bb][Jj]/
[Pp]ublish/
[Aa]rtifacts/
*.binlog
*.nupkg
*.snupkg

# Resultados generados por pruebas.
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml

# Archivos temporales y logs generados.
~$*
*.tmp
*.temp
*.log

# Informes locales de revision de la API.
/Divorcios.Api/Revision/

# Alternativa local de archivos privados; por defecto se guardan fuera del repositorio.
/Divorcios.Api/ArchivosPrivados/

# Documentacion local: publicar solamente el README de la raiz.
*.[mM][dD]
!/README.md

# Documentos Word locales, en cualquier carpeta del repositorio.
*.[dD][oO][cC]
*.[dD][oO][cC][xX]
*.[dD][oO][cC][mM]
